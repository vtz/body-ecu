{
    "version": 4,
    "configurePresets": [
        {
            "name": "posix-debug",
            "displayName": "POSIX Debug",
            "description": "Linux/POSIX debug build with SocketCAN + console GPIO",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/../../build/posix-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "posix-release",
            "displayName": "POSIX Release",
            "description": "Linux/POSIX release build",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/../../build/posix-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "posix-debug",
            "configurePreset": "posix-debug"
        },
        {
            "name": "posix-release",
            "configurePreset": "posix-release"
        }
    ]
}
