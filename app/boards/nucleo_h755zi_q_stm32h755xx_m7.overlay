/* Devicetree overlay for NUCLEO-H755ZI-Q (M7 core) */
/* Enables Ethernet, CAN, ADC, user LEDs, and user button */

&mac {
	status = "okay";
};

&fdcan1 {
	status = "okay";
};

&adc1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* PA3 = Arduino A0 = ADC1_INP15 -- potentiometer wiper */
	channel@f {
		reg = <15>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 810)>;
		zephyr,resolution = <12>;
	};
};
