[Unit]
Description=Body ECU HPC (MPU-side SOME/IP bridge, Kuksa client, and cloud gateway)
After=network-online.target kuksa-databroker.service
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=-/etc/body-ecu/body-ecu-hpc.env
ExecStart=/usr/bin/body-ecu-hpc $MCU_HOST
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
